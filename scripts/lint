#!/usr/bin/env bash
set -euo pipefail

# Move to project root
cd "$(dirname "$0")/.."

echo "Running ruff check..."
uv run ruff check . --fix

echo "Running mypy type checking..."
uv run python -m mypy custom_components/plant_monitor_plus/ --check-untyped-defs --explicit-package-bases

echo "Lint completed successfully!"
